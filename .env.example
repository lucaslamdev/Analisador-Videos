DATA_DIR=data
VIDEOS_INPUT_DIR=incoming
EVENT_MERGE_GAP_SEC=3
SAMPLE_FPS=1
CLIP_PADDING_SEC=2
DEVICE=auto
CONFIDENCE_THRESHOLD=0.5
VEHICLE_CONFIDENCE=0.35
# Bbox em clipes/supercuts — modo sensível (~22% pessoa, ~18% veículos)
ANNOTATE_SENSITIVE_CONFIDENCE=0.22
ANNOTATE_SENSITIVE_VEHICLE_CONFIDENCE=0.18
ANNOTATE_SENSITIVE_IOU=0.4
PDF_MAX_THUMBNAILS=20
PDF_COMPACT_MAX_WIDTH=480
PDF_COMPACT_JPEG_QUALITY=45
PDF_COMPACT_MAX_THUMBNAILS=0
MERGE_SPATIAL_RATIO=0.15

YOLO_MODEL=yolo11n.pt
YOLO_IMGSZ_CPU=960
YOLO_IMGSZ_GPU=1280
YOLO_BATCH_SIZE_CPU=1
YOLO_BATCH_SIZE_GPU=8
YOLO_HALF_GPU=true

MAX_CONCURRENT_JOBS_CPU=2
MAX_CONCURRENT_JOBS_GPU=1
FRAME_CACHE_ENABLED_CPU=true
FRAME_CACHE_ENABLED_GPU=false
FRAME_CACHE_MIN_FREE_GB=5

GENERATE_REPORTS_ON_COMPLETE=false
ALLOW_CPU_FALLBACK=true
PROGRESS_UPDATE_EVERY_N_FRAMES=30
